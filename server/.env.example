# Meta Graph API — 실제 값은 .env 에 넣고 절대 커밋하지 않는다.
#
# IG_ACCESS_TOKEN
#   Graph 를 부를 액세스 토큰. 종류는 서버가 알아서 판별하므로 아무거나 넣으면 된다.
#   비워둬도 서버는 뜬다. 인스타 포트폴리오는 프런트엔드의 데모 데이터로 폴백한다.
#
#   ★ 권장 — 시스템 사용자 토큰(만료 없음)
#     Meta 공식 문서가 "장시간 도는 서비스"에 권장하는 방식이고, 만료가 없어서
#     재발급 자체가 사라진다. 사용자 토큰보다 무효화될 일도 적다.
#     business.facebook.com → 비즈니스 설정 → 사용자 → 시스템 사용자
#       → 시스템 사용자 추가 (역할: 관리자)
#       → [자산 할당] 에서 veily 앱과 veily 페이지를 붙이고 "전체 권한"
#       → [토큰 생성] → 앱 선택 → 만료 "없음" → 권한 6개 체크 → 생성
#     한 번 넣으면 서버가 debug_token 으로 만료 없음을 확인하고 갱신 시도를 멈춘다.
#
#   차선 — 사용자 토큰
#     Graph API Explorer 에서 받은 단기 토큰(1~2시간)을 넣어도 된다. 아래 FB_APP_ID/
#     FB_APP_SECRET 이 있으면 부팅 즉시 장기(60일)·페이지 토큰으로 승격해 저장한다.
#     다만 붙여넣고 1~2시간 안에 서버를 한 번 띄워야 한다. 그 사이 만료되면 처음부터 다시다.
#
#   두 경우 모두 필요한 권한 6개:
#     instagram_basic, instagram_manage_insights,
#     pages_show_list, pages_read_engagement,
#     ads_read, business_management
#   (뒤의 두 개는 페이지가 비즈니스 포트폴리오 소유일 때 필요하다)
IG_ACCESS_TOKEN=

# IG_USER_ID
#   veily Facebook 페이지에 연결된 Instagram 프로 계정 ID.
#   GET /me/accounts?fields=instagram_business_account 로 확인한다.
IG_USER_ID=17841440033789899

# FB_APP_ID / FB_APP_SECRET
#   이 둘을 넣으면 토큰을 손으로 다시 넣을 일이 사라진다. 서버가
#     단기(1~2시간) → 장기(60일) → 페이지 토큰(만료 없음)
#   까지 스스로 끌어올리고, 만료 7일 전부터 자동 갱신한다.
#   developers.facebook.com → 내 앱 → 설정 → 기본 설정 에서 확인한다.
#   시크릿은 절대 프론트로 내려보내지 않는다.
FB_APP_ID=
FB_APP_SECRET=

# PUBLIC_BASE_URL
#   OAuth 콜백 주소의 기준. /api/auth/instagram/start 를 쓰려면 Meta 앱의
#   "유효한 OAuth 리디렉션 URI" 에 {PUBLIC_BASE_URL}/api/auth/instagram/callback 을
#   먼저 등록해야 한다. 2026-08-14 기준 veily 앱에는 아직 등록돼 있지 않아
#   start 경로는 동작하지 않는다. 등록 전이라면 시스템 사용자 토큰을
#   POST /api/auth/instagram/token 으로 넣는 쪽이 빠르다 — 리디렉션 URI 가 필요 없다.
PUBLIC_BASE_URL=http://localhost:4000

# TOKEN_STORE_PATH
#   서버가 갱신한 토큰을 저장하는 파일. .gitignore 에 걸려 있고 0600 으로 쓴다.
TOKEN_STORE_PATH=.secrets/instagram-token.json

# ANTHROPIC_API_KEY
#   가져온 인스타 사진을 taxonomy.json 기준으로 자동 라벨링할 때 쓴다.
#   비워두면 레퍼런스 보드의 "인스타 동기화"만 막히고 나머지는 그대로 동작한다.
#   console.anthropic.com → API keys 에서 발급한다.
#
#   비용은 사진 한 장이 API 호출 한 번이다. 보드에서 한 번에 6/12/24장 중 고를 수 있고
#   이미 라벨이 있는 사진은 건너뛰므로, 같은 업체를 다시 눌러도 중복 과금은 없다.
ANTHROPIC_API_KEY=

# CLASSIFY_MODEL
#   분류에 쓸 모델. 기본은 claude-opus-5 다.
CLASSIFY_MODEL=claude-opus-5

# 선택 — 기본값이 있다.
GRAPH_API_VERSION=v26.0
PORT=4000
