# Meta Graph API — 실제 값은 .env 에 넣고 절대 커밋하지 않는다.
#
# IG_ACCESS_TOKEN
#   Facebook 로그인으로 발급한 사용자 액세스 토큰.
#   개발용 단기 토큰은 1~2시간이면 만료되므로, 운영에서는 60일 장기 토큰을 쓰고
#   D-7 갱신 알림을 걸어둔다.
#   필요 권한 6개:
#     instagram_basic, instagram_manage_insights,
#     pages_show_list, pages_read_engagement,
#     ads_read, business_management
#   (뒤의 두 개는 페이지가 비즈니스 포트폴리오 소유일 때 필요하다)
IG_ACCESS_TOKEN=

# IG_USER_ID
#   veily Facebook 페이지에 연결된 Instagram 프로 계정 ID.
#   GET /me/accounts?fields=instagram_business_account 로 확인한다.
IG_USER_ID=17841440033789899

# 선택 — 기본값이 있다.
GRAPH_API_VERSION=v26.0
PORT=4000
